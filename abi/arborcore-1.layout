# Arborcore Assembly ABI v1 — frozen data layouts
# Target: Linux x86-64, System V AMD64 ABI, little-endian.
# All offsets and sizes are bytes.

BUFFER.size=24
BUFFER.data=0
BUFFER.length=8
BUFFER.capacity=16

ARENA.size=24
ARENA.base=0
ARENA.capacity=8
ARENA.offset=16
ARENA.zero_size_aligned_allocation=align_and_may_advance_frontier

CONNECTION.size=96
CONNECTION.fd=0
CONNECTION.state=8
CONNECTION.flags=16
CONNECTION.input_buffer=24
CONNECTION.output_buffer=32
CONNECTION.arena=40
CONNECTION.read_bytes=48
CONNECTION.write_bytes=56
CONNECTION.request_count=64
CONNECTION.last_error=72
CONNECTION.frame_scan=80
CONNECTION.frame_needed=88
CONNECTION.state.ACCEPTED=1
CONNECTION.state.READING=2
CONNECTION.state.REQUEST_READY=3
CONNECTION.state.DISPATCHING=4
CONNECTION.state.WRITING=5
CONNECTION.state.KEEP_ALIVE=6
CONNECTION.state.CLOSING=7
CONNECTION.state.CLOSED=8

HTTP_REQUEST.size=96
HTTP_REQUEST.method_ptr=0
HTTP_REQUEST.method_len=8
HTTP_REQUEST.target_ptr=16
HTTP_REQUEST.target_len=24
HTTP_REQUEST.version_ptr=32
HTTP_REQUEST.version_len=40
HTTP_REQUEST.headers_ptr=48
HTTP_REQUEST.headers_len=56
HTTP_REQUEST.body_ptr=64
HTTP_REQUEST.body_available=72
HTTP_REQUEST.content_length=80
HTTP_REQUEST.message_length=88

REQUEST_TARGET.size=32
REQUEST_TARGET.path_ptr=0
REQUEST_TARGET.path_len=8
REQUEST_TARGET.query_ptr=16
REQUEST_TARGET.query_len=24

ROUTE.size=40
ROUTE.method_ptr=0
ROUTE.method_len=8
ROUTE.pattern_ptr=16
ROUTE.pattern_len=24
